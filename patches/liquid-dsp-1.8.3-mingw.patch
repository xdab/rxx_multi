MinGW/UCRT64 build fixes for liquid-dsp 1.8.3 (no other changes needed).

strsep() and getrusage()/sys/resource.h are absent from the UCRT. Apply
before building, e.g.:

    curl -sL https://github.com/jgaeddert/liquid-dsp/archive/refs/tags/v1.8.3.tar.gz | tar xz
    patch -d liquid-dsp-1.8.3 -p1 < patches/liquid-dsp-1.8.3-mingw.patch

--- a/src/core/src/logging.c
+++ b/src/core/src/logging.c
@@ -31,6 +31,23 @@
 #include <unistd.h>
 #include "liquid.internal.h"
 
+#if defined(_WIN32)
+// BSD strsep() is not in the UCRT; only used for the config-string parser
+static char * strsep(char ** stringp, const char * delim)
+{
+    char * start = *stringp;
+    if (start == NULL)
+        return NULL;
+    char * end = start + strcspn(start, delim);
+    if (*end != '\0')
+        *end++ = '\0';
+    else
+        *stringp = NULL;
+    *stringp = end;
+    return start;
+}
+#endif
+
 #ifdef LIQUID_COLOR_ENABLE
     // enable ANSI escape colors
     const char * liquid_log_color_soft  = "\033[90m";
--- a/src/core/src/timer.c
+++ b/src/core/src/timer.c
@@ -24,7 +24,23 @@
 #include <stdio.h>
 #include <unistd.h>
 #include <sys/time.h>
+#if !defined(_WIN32)
 #include <sys/resource.h>
+#else
+// UCRT has no getrusage(): the RUSAGE timer degrades to wall clock
+struct rusage
+{
+    struct timeval ru_utime;
+    struct timeval ru_stime;
+};
+#define RUSAGE_SELF 0
+static int getrusage(int who, struct rusage * usage)
+{
+    (void) who;
+    gettimeofday(&usage->ru_utime, NULL);
+    return 0;
+}
+#endif
 
 #include "liquid.h"
